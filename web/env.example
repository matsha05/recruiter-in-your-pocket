# Canonical production base URL for auth and Stripe return paths.
# Local requests use their own origin. Vercel previews use VERCEL_URL so they
# cannot send callbacks to production when this value is inherited by Preview.
# Local example: http://localhost:3000
NEXT_PUBLIC_APP_URL=

NEXT_PUBLIC_SUPABASE_URL=
# Preferred current key name. The legacy anon alias remains supported below.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_BUCKET=resumes
NEXT_PUBLIC_MIXPANEL_TOKEN=
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS=
NEXT_PUBLIC_ENABLE_BILLING_UNLOCK=false
NEXT_PUBLIC_ENABLE_LINKEDIN_REVIEW=false
NEXT_PUBLIC_ENABLE_EXTENSION_SYNC=false
NEXT_PUBLIC_ENABLE_GUEST_REPORT_SAVE=false
NEXT_PUBLIC_ENABLE_PUBLIC_SHARE_LINKS=false
NEXT_PUBLIC_ENABLE_ERROR_REPLAY=false
NEXT_PUBLIC_ENABLE_SENTRY=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_ENABLE_LOGS=false

# Internal launch command center (/launch and /api/ready)
# Localhost can open these without auth. Hosted environments require both values.
INTERNAL_LAUNCH_ACCESS=false
INTERNAL_LAUNCH_ADMIN_EMAILS=

# --- Server-only (Route Handlers / Webhooks) ---
# Used to sign the free-run cookie. Any long random string.
SESSION_SECRET=

# Transactional authentication email. Supabase generates the verifiable OTP;
# RIYP sends the exact code email through Resend instead of relying on a hosted
# template. The sender must be on a verified Resend domain.
RESEND_API_KEY=
RIYP_AUTH_EMAIL_FROM=Recruiter in Your Pocket <noreply@recruiterinyourpocket.com>
# Signed Resend Inbound webhook and private forwarding destination.
RIYP_SUPPORT_FORWARDING_ENABLED=false
RESEND_WEBHOOK_SECRET=
RIYP_SUPPORT_FORWARD_TO=
RIYP_SUPPORT_FORWARD_FROM=Recruiter in Your Pocket Support <noreply@recruiterinyourpocket.com>
RIYP_SUPPORT_INBOX_VERIFIED=false

# OpenAI for resume analysis (server-only)
OPENAI_API_KEY=
# Spending guard for PromptOps evaluation scripts only. Keep false until an
# explicit evaluation budget is approved.
RIYP_ALLOW_PAID_EVALS=false
# Atomic production ceiling for generation requests. The counter is shared in Redis and
# resets by UTC day. Tune deliberately from observed cost and conversion data.
RIYP_MAX_DAILY_GENERATIONS=250
# Emergency server-side switches. Leave false in normal operation.
RIYP_DISABLE_GENERATION=false

# These are evidence flags, not setup toggles. Set them to true only after the
# real destinations have passed the rehearsals in 87-operational-ownership.md.
RIYP_SUPPORT_INBOX_VERIFIED=false
RIYP_SECONDARY_ALERT_VERIFIED=false
RIYP_DISABLE_NEW_PURCHASES=false
# OPENAI_MODEL=gpt-4.1-mini
# Resume reports default to this pinned model even when OPENAI_MODEL is set.
OPENAI_RESUME_MODEL=gpt-5.6-luna
OPENAI_RESUME_REASONING_EFFORT=low
# Auxiliary corpus generation and LLM-as-judge models. These do not replace
# the launch resume model used by the eval runner.
OPENAI_EVAL_GENERATOR_MODEL=gpt-4o-mini
OPENAI_JUDGE_MODEL=gpt-4o-mini
# Complex reports may need a low-reasoning attempt plus one medium retry.
OPENAI_TIMEOUT_MS=90000
# OPENAI_MAX_RETRIES=1
# OPENAI_RETRY_BACKOFF_MS=300

# Stripe (server-only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Launch offer: $29 once, 5 additional reports, expires after 30 days.
STRIPE_PRICE_ID_30D=
STRIPE_PRODUCT_ID_30D=
# Legacy restore-only prices. Do not use these for new checkout sessions.
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRODUCT_ID_MONTHLY=
STRIPE_PRICE_ID_LIFETIME=
STRIPE_PRODUCT_ID_LIFETIME=
STRIPE_PRICE_ID_24H=
STRIPE_PRODUCT_ID_24H=

# Supabase admin key for metering, account workflows, and Stripe webhook writes.
# Prefer the current secret key. Never expose either value to browser code.
SUPABASE_SECRET_KEY=
# Legacy fallback:
SUPABASE_SERVICE_ROLE_KEY=
# Direct or session-pooler Postgres URL for the active Supabase project. The
# migration runner intentionally ignores generic DATABASE_URL values so an old
# or unrelated database cannot be modified accidentally.
SUPABASE_DB_URL=
SUPABASE_PROJECT_ID=

# Upstash Redis for rate limiting and idempotency (server-only)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Existing Vercel Marketplace databases may expose these compatible aliases.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Comma-separated exact extension origins, e.g.
# RIYP_EXTENSION_ORIGINS=chrome-extension://abcdefghijklmnopqrstuvwxyzabcdef
# Keep NEXT_PUBLIC_ENABLE_EXTENSION_SYNC=false until this is set.
RIYP_EXTENSION_ORIGINS=

# Server-only gate for the experimental resume-ideas API. Keep disabled for launch.
RIYP_ENABLE_RESUME_IDEAS_API=false

# Optional toggles
# BYPASS_PAYWALL=true
# USE_SPARTICUZ_CHROMIUM=true
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_ENABLE_LOGS=false
