{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "dev:webpack": "next dev --webpack",
    "build": "next build --webpack",
    "postbuild": "node scripts/ensure-next-build-package.cjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "assets:chrome-web-store": "node scripts/generate-chrome-web-store-assets.cjs",
    "test:ui": "playwright test",
    "test:launch-smoke": "node scripts/run-launch-smoke.cjs",
    "test:redteam-journeys": "node scripts/run-redteam-journeys.cjs",
    "preflight:stripe": "node scripts/stripe-launch-preflight.cjs",
    "preflight:stripe:remote": "node scripts/stripe-launch-preflight.cjs --remote",
    "qa:design-system": "node scripts/qa/design-system-guardrails.mjs",
    "test:injection": "node scripts/run-ts-test.cjs tests/injection.test.ts",
    "test:pii": "node scripts/run-ts-test.cjs tests/pii.test.ts",
    "test:extension-cors": "node scripts/run-ts-test.cjs tests/extension-cors.test.ts",
    "test:auth-redirect": "node scripts/run-ts-test.cjs tests/auth-redirect.test.ts",
    "test:auth-email": "node scripts/run-ts-test.cjs tests/auth-email.test.ts",
    "test:billing-access": "node scripts/run-ts-test.cjs tests/billing-access.test.ts",
    "test:billing-pricing": "node scripts/run-ts-test.cjs tests/billing-pricing.test.ts",
    "test:stripe-security": "node scripts/run-ts-test.cjs tests/stripe-security.test.ts",
    "test:stripe-fulfillment": "node scripts/run-ts-test.cjs tests/stripe-fulfillment.test.ts",
    "test:request-body": "node scripts/run-ts-test.cjs tests/request-body.test.ts",
    "test:generation-access": "node scripts/run-ts-test.cjs tests/generation-access.test.ts",
    "test:generation-budget": "node scripts/run-ts-test.cjs tests/generation-budget.test.ts",
    "test:matching-engine": "node scripts/run-ts-test.cjs tests/matching-engine.test.ts",
    "test:critical-coverage": "c8 --all --include='lib/matching/skill-engine.ts' --reporter=text --reporter=json-summary --check-coverage --lines=70 --functions=65 --branches=60 node scripts/run-ts-test.cjs tests/matching-engine.test.ts",
    "test:redis-config": "node scripts/run-ts-test.cjs tests/redis-config.test.ts",
    "test:supabase-config": "node scripts/run-ts-test.cjs tests/supabase-config.test.ts",
    "test:backend-contracts": "node scripts/run-ts-test.cjs tests/backend-contracts.test.ts && node scripts/run-ts-test.cjs tests/prompt-assets.test.ts",
    "test:llm-contract": "node scripts/run-ts-test.cjs tests/llm-response-contract.test.ts",
    "test:privacy-lifecycle": "node scripts/run-ts-test.cjs tests/account-privacy-lifecycle.test.ts && node scripts/run-ts-test.cjs tests/account-export-job.test.ts",
    "test:vendor-privacy": "node scripts/run-ts-test.cjs tests/vendor-privacy.test.ts",
    "test:analytics-privacy": "node scripts/run-ts-test.cjs tests/analytics-privacy.test.ts",
    "test:pdf-export": "node scripts/run-ts-test.cjs tests/pdf-export.test.ts",
    "test:eval-report": "node scripts/run-ts-test.cjs tests/eval-report.test.ts",
    "test:release-integrity": "npm run test:llm-contract && npm run test:pdf-export && npm run test:eval-report",
    "test:accessibility": "playwright test tests/ui/accessibility.spec.ts --project=chromium",
    "test:security": "npm run test:injection && npm run test:pii && npm run test:extension-cors && npm run test:auth-redirect && npm run test:auth-email && npm run test:billing-access && npm run test:billing-pricing && npm run test:stripe-security && npm run test:stripe-fulfillment && npm run test:request-body && npm run test:generation-access && npm run test:generation-budget && npm run test:redis-config && npm run test:supabase-config && npm run test:backend-contracts && npm run test:privacy-lifecycle && npm run test:vendor-privacy && npm run test:analytics-privacy",
    "eval": "node scripts/run-ts-script.cjs scripts/run-eval.ts",
    "eval:dry-run": "node scripts/run-ts-script.cjs scripts/run-eval.ts --dry-run",
    "eval:smoke": "node scripts/run-ts-script.cjs scripts/run-eval.ts --tier smoke --budget-usd 1",
    "eval:golden": "node scripts/run-ts-script.cjs scripts/run-eval.ts --tier golden --budget-usd 5",
    "eval:bulk": "node scripts/run-ts-script.cjs scripts/run-eval.ts --tier bulk --budget-usd 10",
    "eval:generate": "node scripts/run-ts-script.cjs scripts/generate-corpus.ts",
    "eval:import-hf": "node scripts/run-ts-script.cjs scripts/import-huggingface.ts",
    "eval:import-opensporks": "node scripts/run-ts-script.cjs scripts/import-opensporks.ts",
    "eval:bulk-analyze": "node scripts/run-ts-script.cjs scripts/bulk-analyze.ts"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.2.8",
