*
!.gitignore

# Only the first sealed, synthetic-only comparison is deployable. The explicit
# shape prevents staging directories, full eval runs, and unrelated files from
# becoming tracked operator evidence.
!iteration-001/
iteration-001/*

!iteration-001/outputs/
iteration-001/outputs/*
!iteration-001/outputs/candidate/
!iteration-001/outputs/production/
!iteration-001/outputs/candidate/*.json
!iteration-001/outputs/production/*.json

!iteration-001/presentations/
iteration-001/presentations/*
!iteration-001/presentations/candidate/
!iteration-001/presentations/production/
!iteration-001/presentations/candidate/*.jpg
!iteration-001/presentations/candidate/*.jpeg
!iteration-001/presentations/candidate/*.png
!iteration-001/presentations/production/*.jpg
!iteration-001/presentations/production/*.jpeg
!iteration-001/presentations/production/*.png

!iteration-001/packets/
iteration-001/packets/*
!iteration-001/packets/*.json
!iteration-001/packets/assets/
!iteration-001/packets/assets/*.jpg
!iteration-001/packets/assets/*.jpeg
!iteration-001/packets/assets/*.png

!iteration-001/reference-packets/
!iteration-001/reference-packets/*.json
!iteration-001/operator/
!iteration-001/operator/mapping.json
!iteration-001/judgments/
!iteration-001/judgments/*.json
!iteration-001/source-audits/
!iteration-001/source-audits/*.json
!iteration-001/reference-assessments/
!iteration-001/reference-assessments/*.json

!iteration-001/journeys/
iteration-001/journeys/*
!iteration-001/journeys/*.json
!iteration-001/journeys/evidence/
!iteration-001/journeys/evidence/*.json
!iteration-001/journeys/evidence/*.txt
!iteration-001/journeys/evidence/*.log
!iteration-001/journeys/evidence/*.jpg
!iteration-001/journeys/evidence/*.jpeg
!iteration-001/journeys/evidence/*.png
