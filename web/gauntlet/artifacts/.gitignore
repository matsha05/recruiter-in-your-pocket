*
!.gitignore

# Only the active synthetic-only iteration-002 evidence shape may be tracked.
# Staging directories, full eval runs, customer data, and unrelated files stay ignored.
!iteration-002/
iteration-002/*

!iteration-002/outputs/
iteration-002/outputs/*
!iteration-002/outputs/candidate/
!iteration-002/outputs/production/
!iteration-002/outputs/candidate/*.json
!iteration-002/outputs/production/*.json

!iteration-002/presentations/
iteration-002/presentations/*
!iteration-002/presentations/candidate/
!iteration-002/presentations/production/
!iteration-002/presentations/candidate/*.jpg
!iteration-002/presentations/candidate/*.jpeg
!iteration-002/presentations/candidate/*.png
!iteration-002/presentations/production/*.jpg
!iteration-002/presentations/production/*.jpeg
!iteration-002/presentations/production/*.png

!iteration-002/packets/
iteration-002/packets/*
!iteration-002/packets/*.json
!iteration-002/packets/assets/
!iteration-002/packets/assets/*.jpg
!iteration-002/packets/assets/*.jpeg
!iteration-002/packets/assets/*.png

!iteration-002/reference-packets/
!iteration-002/reference-packets/*.json
!iteration-002/operator/
!iteration-002/operator/mapping.json
!iteration-002/judgments/
!iteration-002/judgments/*.json
!iteration-002/source-audits/
!iteration-002/source-audits/*.json
!iteration-002/reference-assessments/
!iteration-002/reference-assessments/*.json
!iteration-002/critic/
!iteration-002/critic/verdict.json

!iteration-002/journeys/
iteration-002/journeys/*
!iteration-002/journeys/*.json
!iteration-002/journeys/evidence/
!iteration-002/journeys/evidence/*.json
!iteration-002/journeys/evidence/*.txt
!iteration-002/journeys/evidence/*.log
!iteration-002/journeys/evidence/*.jpg
!iteration-002/journeys/evidence/*.jpeg
!iteration-002/journeys/evidence/*.png
