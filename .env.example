# Recruiter in Your Pocket - root tooling environment
#
# Copy this file to .env for root scripts and tests. The web app has its own
# canonical template at web/env.example; copy that file to web/.env.local.
# Keep credentials empty here. Never commit populated .env files.

# Local/candidate URL used by launch-readiness checks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Launch features default off. Enable only after their documented rehearsals.
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_MIXPANEL_TOKEN=
NEXT_PUBLIC_ENABLE_BILLING_UNLOCK=false
NEXT_PUBLIC_ENABLE_EXTENSION_SYNC=false
NEXT_PUBLIC_ENABLE_GUEST_REPORT_SAVE=false
NEXT_PUBLIC_ENABLE_PUBLIC_SHARE_LINKS=false
NEXT_PUBLIC_ENABLE_ERROR_REPLAY=false

# Supabase client and server credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy browser-key fallback:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
# Legacy server-key fallback:
SUPABASE_SERVICE_ROLE_KEY=

# Migration target. scripts/migrate.js verifies that the URL and project ref
# agree before applying hosted migrations; generic DATABASE_URL is ignored.
SUPABASE_DB_URL=
SUPABASE_PROJECT_ID=
# Optional legacy project-ref alias:
RIYP_EXPECTED_SUPABASE_PROJECT_REF=

# OpenAI for resume analysis and explicitly approved evaluation runs.
OPENAI_API_KEY=
RIYP_ALLOW_PAID_EVALS=false
# OPENAI_MODEL=gpt-4.1-mini
OPENAI_RESUME_MODEL=gpt-5.6-terra
OPENAI_RESUME_REASONING_EFFORT=medium
OPENAI_EVAL_GENERATOR_MODEL=gpt-4o-mini
OPENAI_JUDGE_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=90000
OPENAI_MAX_RETRIES=1
OPENAI_RETRY_BACKOFF_MS=300
USE_MOCK_OPENAI=

# Shared generation guardrails. Keep emergency switches false normally.
RIYP_MAX_DAILY_GENERATIONS=250
RIYP_DISABLE_GENERATION=false
RIYP_DISABLE_NEW_PURCHASES=false
RIYP_ENABLE_RESUME_IDEAS_API=false

# Session signing and transactional support email.
SESSION_SECRET=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RIYP_SUPPORT_FORWARDING_ENABLED=false
RIYP_SUPPORT_FORWARD_TO=
# Example: Recruiter in Your Pocket Support <noreply@your-verified-domain.example>
RIYP_SUPPORT_FORWARD_FROM=
RIYP_SUPPORT_OPERATOR_EMAILS=
# Evidence flags stay false until real receive/reply and alert rehearsals pass.
RIYP_SUPPORT_INBOX_VERIFIED=false
RIYP_SECONDARY_ALERT_VERIFIED=false

# Stripe launch offer (server-only).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_30D=
STRIPE_PRODUCT_ID_30D=

# Shared Redis. Configure either the Upstash pair or the compatible KV pair.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Comma-separated exact Chrome extension origins. Keep sync disabled until set.
RIYP_EXTENSION_ORIGINS=

# Optional secondary Sentry-to-GitHub alert delivery script.
RIYP_SENTRY_READ_TOKEN=
GITHUB_TOKEN=
GITHUB_REPOSITORY=
RIYP_ALERT_LOOKBACK_MINUTES=120

# Root test helper. Leave false unless deliberately rebuilding its Next fixture.
FORCE_NEXT_BUILD=false
